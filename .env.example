# Reference only. `pnpm setup` writes real local secrets to ignored .local/development.env.
APP_ENV=development
LOCAL_DEMO_MODE=true
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_PORT=3000
WEB_ORIGINS=http://localhost:5173,http://localhost:3000
# Optional when transactional email links should use a different browser origin.
PUBLIC_WEB_URL=http://localhost:5173
DATABASE_URL=postgresql+psycopg://shadowgrid:use-a-local-secret@localhost:5432/shadowgrid
REDIS_URL=redis://localhost:6379/0
SMTP_HOST=localhost
SMTP_PORT=1025
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=shadowgrid
ACCESS_TOKEN_MINUTES=10
REFRESH_TOKEN_DAYS=30
AUTH_LOGIN_RATE_LIMIT=8
AUTH_LOGIN_RATE_WINDOW_SECONDS=600
AUTH_EMAIL_RATE_LIMIT=5
AUTH_EMAIL_RATE_WINDOW_SECONDS=3600
AUTH_TOKEN_RATE_LIMIT=10
AUTH_TOKEN_RATE_WINDOW_SECONDS=600
SEASON_DAYS=14
SEED_VERSION=1
DEMO_RANDOM_SEED=28001
STARTING_CASH_CENTS=8000000
COMPANY_FOUNDING_COST_CENTS=2000000
IPO_MIN_ENTERPRISE_VALUE_CENTS=10000000
IPO_PROFITABLE_PERIODS=3
IPO_MIN_COMPLIANCE_BPS=6000
IPO_MIN_EMPLOYEES=8
IPO_MAX_INVESTIGATION_PRESSURE_BPS=2500
IPO_FEE_CENTS=500000
EXCHANGE_ORDER_RATE_LIMIT_PER_MINUTE=60
EXCHANGE_MAX_PRICE_DEVIATION_BPS=5000
CARTEL_CREATION_COST_CENTS=1000000
CARTEL_DEFAULT_APPROVAL_THRESHOLD_CENTS=250000
CARTEL_DEFAULT_SINGLE_SPEND_LIMIT_CENTS=2500000
CARTEL_CONTROL_THRESHOLD=100
CARTEL_CONTROL_MARGIN=20
INTELLIGENCE_OPERATION_RATE_LIMIT_PER_MINUTE=12
INTELLIGENCE_OPERATION_COOLDOWN_MINUTES=30
STRATEGIC_ACTION_RATE_LIMIT_PER_MINUTE=6
STRATEGIC_ACTION_COOLDOWN_MINUTES=120
STRATEGIC_EFFECT_MINUTES=180
CONTRACT_SETTLEMENT_INTERVAL_MINUTES=60
CONTRACT_TENDER_MAX_DURATION_PERIODS=168
CONTRACT_REPUTATION_REWARD_BPS=250
CONTRACT_BREACH_REPUTATION_PENALTY_BPS=750
CONTRACT_BREACH_INVESTIGATION_PENALTY_BPS=250
LOAN_PAYMENT_INTERVAL_MINUTES=1440
LOAN_OFFER_VALID_MINUTES=1440
LOAN_MAX_PRINCIPAL_CENTS=100000000
LOAN_MAX_TERM_PERIODS=30
LOAN_BASE_INTEREST_RATE_BPS=800
LOAN_MIN_INTEREST_RATE_BPS=200
LOAN_MAX_INTEREST_RATE_BPS=5000
LOAN_DEFAULT_REPUTATION_PENALTY_BPS=750
LOAN_DEFAULT_INVESTIGATION_PENALTY_BPS=1000
BOND_COUPON_INTERVAL_MINUTES=1440
BOND_OFFERING_MINUTES=1440
BOND_MAX_PRINCIPAL_CENTS=100000000
BOND_MAX_TERM_PERIODS=30
BOND_DEFAULT_REPUTATION_PENALTY_BPS=1000
BOND_DEFAULT_INVESTIGATION_PENALTY_BPS=1250
