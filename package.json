{
  "name": "shadowgrid",
  "version": "0.1.0",
  "private": true,
  "description": "Server-authoritative seasonal strategy MMO",
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "check:environment": "powershell -ExecutionPolicy Bypass -File scripts/check-environment.ps1",
    "setup": "powershell -ExecutionPolicy Bypass -File scripts/project.ps1 setup",
    "dev": "concurrently --kill-others -n api,web -c yellow,cyan \"pnpm dev:api\" \"pnpm --filter @shadowgrid/web dev\"",
    "dev:api": "node scripts/run-python.mjs --cwd apps/api -m uvicorn shadowgrid.main:app --reload --host 0.0.0.0 --port 8000",
    "migrate": "node scripts/run-python.mjs --cwd apps/api -m alembic upgrade head",
    "migrate:rollback": "node scripts/run-python.mjs --cwd apps/api -m alembic downgrade base",
    "seed": "pnpm migrate && node scripts/run-python.mjs --cwd apps/api -m shadowgrid.seed",
    "format:check": "pnpm --recursive --if-present format:check && node scripts/run-python.mjs -m ruff format --check apps tests",
    "lint": "pnpm --recursive --if-present lint && node scripts/run-python.mjs -m ruff check apps tests",
    "typecheck": "pnpm --recursive --if-present typecheck && node scripts/run-python.mjs -m mypy apps/api/shadowgrid apps/worker",
    "test": "pnpm --recursive --if-present test && node scripts/run-python.mjs --cwd apps/api -m pytest tests -q --cov=shadowgrid --cov-report=term --cov-fail-under=65",
    "test:e2e": "pnpm --filter @shadowgrid/web test:e2e",
    "test:lifecycle": "node scripts/verify-lifecycle.mjs",
    "test:security": "powershell -ExecutionPolicy Bypass -File scripts/security-scan.ps1",
    "scan:secrets": "powershell -ExecutionPolicy Bypass -File scripts/secret-scan.ps1",
    "test:load": "node scripts/run-python.mjs -m pytest tests/load -q",
    "test:balance": "node scripts/run-python.mjs --cwd apps/api -m shadowgrid.balance_simulation && node scripts/run-python.mjs --cwd apps/api -m pytest -q tests/test_balance_simulation.py",
    "test:season-runbook": "node scripts/run-python.mjs --cwd apps/api -m pytest -q tests/test_seasons.py",
    "test:smoke-script": "node --test scripts/smoke-test.test.mjs",
    "ops:verify": "node scripts/verify-operations.mjs",
    "ops:restore-drill": "node scripts/run-python.mjs --cwd apps/api -m shadowgrid.restore_drill",
    "mobile:release:verify": "node scripts/verify-mobile-release.mjs",
    "test:email-release": "node scripts/run-python.mjs --cwd apps/api -m pytest -q tests/test_mailer.py tests/test_email_account_flows.py tests/test_auth.py",
    "test:release-materials": "node --test scripts/verify-release-materials.test.mjs",
    "release:materials": "node scripts/verify-release-materials.mjs",
    "release:final-run": "node scripts/final-release-run.mjs",
    "store:validate-captures": "node scripts/validate-store-assets.mjs",
    "store:prepare-static": "node scripts/prepare-store-static-art.mjs",
    "store:ingest-static": "node scripts/prepare-store-static-art.mjs --ingest",
    "store:ingest-captures": "node scripts/ingest-store-captures.mjs",
    "store:report": "node scripts/write-store-readiness.mjs",
    "store:gate": "node scripts/write-store-readiness.mjs --gate",
    "smoke:staging:dry-run": "node scripts/smoke-test.mjs --target=staging --base-url=https://staging.example.invalid --dry-run",
    "smoke:production:dry-run": "node scripts/smoke-test.mjs --target=production --base-url=https://production.example.invalid --dry-run",
    "smoke:staging": "node scripts/smoke-test.mjs --target=staging",
    "smoke:production": "node scripts/smoke-test.mjs --target=production",
    "data:verify": "node scripts/run-python.mjs --cwd apps/api -m shadowgrid.release_checks",
    "i18n:extract": "pnpm --filter @shadowgrid/i18n extract",
    "i18n:bootstrap": "pnpm --filter @shadowgrid/i18n bootstrap",
    "i18n:validate": "pnpm --filter @shadowgrid/i18n validate",
    "i18n:release": "pnpm --filter @shadowgrid/i18n release",
    "i18n:scan": "pnpm --filter @shadowgrid/i18n scan",
    "i18n:screenshots": "pnpm --filter @shadowgrid/web capture:localization",
    "i18n:pseudo": "pnpm --filter @shadowgrid/i18n pseudo",
    "i18n:translate": "pnpm --filter @shadowgrid/i18n translate",
    "i18n:report": "pnpm --filter @shadowgrid/i18n report",
    "api:generate": "node scripts/run-python.mjs scripts/export-openapi.py && pnpm --filter @shadowgrid/api-client generate",
    "assets:manifest": "node scripts/assets/pipeline.mjs manifest",
    "assets:style-proof": "node scripts/assets/pipeline.mjs style-proof",
    "assets:next": "node scripts/assets/pipeline.mjs next",
    "assets:batch": "node scripts/assets/pipeline.mjs batch",
    "assets:city": "node scripts/assets/pipeline.mjs city",
    "assets:all": "node scripts/assets/pipeline.mjs all",
    "assets:resume": "node scripts/assets/pipeline.mjs resume",
    "assets:validate": "node scripts/assets/pipeline.mjs validate",
    "assets:optimize": "node scripts/assets/pipeline.mjs optimize",
    "assets:runtime-sync": "node scripts/assets/pipeline.mjs runtime-sync",
    "assets:contact-sheets": "node scripts/assets/pipeline.mjs contact-sheets",
    "assets:preview": "node scripts/assets/pipeline.mjs preview",
    "assets:integration-test": "node scripts/assets/pipeline.mjs integration-test",
    "assets:gate": "node scripts/assets/pipeline.mjs gate",
    "assets:report": "node scripts/assets/pipeline.mjs report",
    "assets:ingest": "node scripts/assets/pipeline.mjs ingest",
    "assets:geodata": "node scripts/assets/build-germany-map.mjs",
    "assets:regenerate": "node scripts/assets/pipeline.mjs regenerate",
    "assets:review": "node scripts/assets/pipeline.mjs review",
    "assets:test": "node --test scripts/assets/*.test.mjs",
    "visual:inventory": "node scripts/visual/visual-inventory.mjs",
    "visual:capture-baseline": "powershell -ExecutionPolicy Bypass -Command \"$env:SHADOWGRID_CAPTURE_VISUAL_BASELINE='1'; pnpm --filter @shadowgrid/web exec playwright test e2e/visual-baseline.spec.ts --project=chromium --project=mobile; if ($LASTEXITCODE -eq 0) { node scripts/visual/merge-baseline-evidence.mjs }\"",
    "visual:test-reference": "pnpm --filter @shadowgrid/web exec playwright test e2e/visual-reference.spec.ts",
    "visual:test-locales": "pnpm --filter @shadowgrid/web exec playwright test e2e/visual-locales.spec.ts --project=chromium",
    "visual:performance-budget": "node scripts/visual/check-performance-budget.mjs",
    "visual:report": "node scripts/visual/write-implementation-report.mjs",
    "build": "pnpm --workspace-concurrency=1 --recursive --if-present build",
    "clean": "powershell -ExecutionPolicy Bypass -File scripts/project.ps1 clean",
    "validate": "powershell -ExecutionPolicy Bypass -File scripts/project.ps1 validate",
    "logs": "docker compose logs -f --tail=200",
    "stop": "docker compose down"
  },
  "devDependencies": {
    "concurrently": "9.2.0",
    "sharp": "0.35.3"
  }
}
